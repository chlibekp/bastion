# Pinned third-party dependencies. Sourced by scripts/build-deps.sh.
# Every archive is verified against its SHA-256 before extraction.
#
# Provenance of each hash:
#   openssl, zstd         match the checksum file published beside the release asset
#   ngtcp2, nghttp3       match the release's checksums.txt
#   pcre2                 matches the sha256 digest GitHub records for the release asset
#   liburing, libbpf,     upstream publishes no checksum for these tags; the archive is the
#   brotli, zlib-ng,      GitHub-generated tag tarball, hashed on first download (pin only,
#   mimalloc              not independent verification). Re-verify against a signed tag when bumping.
#
# Floors: OpenSSL >= 3.5, ngtcp2 >= 1.24.

OPENSSL_VERSION=3.5.9
OPENSSL_URL="https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz"
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

NGTCP2_VERSION=1.26.0
NGTCP2_URL="https://github.com/ngtcp2/ngtcp2/releases/download/v${NGTCP2_VERSION}/ngtcp2-${NGTCP2_VERSION}.tar.xz"
NGTCP2_SHA256=7804aa0fa1c39942ba322a90805824c37231f7675b08d0c3cc4332858a7b085e

NGHTTP3_VERSION=1.19.0
NGHTTP3_URL="https://github.com/ngtcp2/nghttp3/releases/download/v${NGHTTP3_VERSION}/nghttp3-${NGHTTP3_VERSION}.tar.xz"
NGHTTP3_SHA256=228e17f5cc3d4de7bfced9912bd09de30e7f45741cc47503cf88d3fa9209e155

LIBURING_VERSION=2.15
LIBURING_URL="https://github.com/axboe/liburing/archive/refs/tags/liburing-${LIBURING_VERSION}.tar.gz"
LIBURING_SHA256=8d052f2622dcb3678cbaee5ff582a87572672a6c0a56533cdda5b65cb636120a

LIBBPF_VERSION=1.8.0
LIBBPF_URL="https://github.com/libbpf/libbpf/archive/refs/tags/v${LIBBPF_VERSION}.tar.gz"
LIBBPF_SHA256=b7a1e685f90f6a63ead0dd85d053694b222975da8d09c1a966041cff6f0055ff

PCRE2_VERSION=10.49
PCRE2_URL="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-${PCRE2_VERSION}/pcre2-${PCRE2_VERSION}.tar.bz2"
PCRE2_SHA256=53c156e1ba416a20da8e65395daa132da0d80e76910424caca3fcdae7831d384

ZSTD_VERSION=1.5.7
ZSTD_URL="https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz"
ZSTD_SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3

BROTLI_VERSION=1.2.1
BROTLI_URL="https://github.com/google/brotli/archive/refs/tags/v${BROTLI_VERSION}.tar.gz"
BROTLI_SHA256=98d35d11a78dc453aebb7d10c3748f3f73ff78c8267c0dc697b8631f67bf7e8f

ZLIBNG_VERSION=2.3.3
ZLIBNG_URL="https://github.com/zlib-ng/zlib-ng/archive/refs/tags/${ZLIBNG_VERSION}.tar.gz"
ZLIBNG_SHA256=f9c65aa9c852eb8255b636fd9f07ce1c406f061ec19a2e7d508b318ca0c907d1

MIMALLOC_VERSION=3.6.1
MIMALLOC_URL="https://github.com/microsoft/mimalloc/archive/refs/tags/v${MIMALLOC_VERSION}.tar.gz"
MIMALLOC_SHA256=2672e6a99d4579fb4bb32d9de0d63aa424ce600d31fbfaf06eb74d940d2e07a6

# Build order matters: nghttp3/ngtcp2 need OpenSSL.
DEP_ORDER="openssl nghttp3 ngtcp2 liburing libbpf pcre2 zstd brotli zlibng mimalloc"
