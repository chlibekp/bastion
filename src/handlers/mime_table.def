/* Built-in extension to media type table: X(extension, type). Extensions are lower case. Text types
 * carry their charset; the `types` directive adds to this table and wins over it. */
X("html", "text/html; charset=utf-8")
X("htm", "text/html; charset=utf-8")
X("css", "text/css; charset=utf-8")
X("js", "text/javascript; charset=utf-8")
X("mjs", "text/javascript; charset=utf-8")
